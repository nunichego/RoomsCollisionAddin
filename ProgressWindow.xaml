<Window x:Class="RoomsManagerAddin.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Collision Analysis Progress" 
        Height="200" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Room Collision Analysis" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <TextBlock x:Name="StageTextBlock" Grid.Row="1" Text="Initializing..." 
                   FontSize="12" Margin="0,0,0,5"/>
        
        <TextBlock x:Name="DetailTextBlock" Grid.Row="2" Text="" 
                   FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>
        
        <TextBlock x:Name="StepProgressTextBlock" Grid.Row="3" Text="Step Progress: 0%" 
                   FontSize="10" Foreground="Blue" Margin="0,0,0,2"/>
        
        <ProgressBar x:Name="StepProgressBar" Grid.Row="4" Height="15" 
                     Minimum="0" Maximum="100" Value="0" Margin="0,0,0,5"/>
        
        <TextBlock x:Name="OverallProgressTextBlock" Grid.Row="5" Text="Overall Progress: 0%" 
                   FontSize="10" Foreground="Green" Margin="0,0,0,2"/>
        
        <ProgressBar x:Name="OverallProgressBar" Grid.Row="6" Height="15" 
                     Minimum="0" Maximum="100" Value="0" Margin="0,0,0,5"/>
        
        <TextBlock x:Name="TimeTextBlock" Grid.Row="7" Text="Elapsed: 00:00" 
                   FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
    </Grid>
</Window>
