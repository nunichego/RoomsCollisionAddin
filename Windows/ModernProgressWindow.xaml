<Window x:Class="RoomsManagerAddin.Windows.ModernProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RoomsManagerAddin.Models"
        Title="RoomDataSync - Analysis Progress"
        Height="280" Width="480"
        MinHeight="280" MinWidth="480"
        MaxHeight="320" MaxWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Window.Resources>
        <!-- Modern Progress Bar Style -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Spinning animation for indeterminate progress -->
        <Style x:Key="SpinnerStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" 
                                               From="0" To="360" Duration="0:0:2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Container with Shadow -->
    <Border Background="White" 
            CornerRadius="12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Opacity="0.15" 
                            ShadowDepth="2" 
                            BlurRadius="10"/>
        </Border.Effect>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Icon and Title -->
                <RowDefinition Height="*"/>    <!-- Progress Content -->
                <RowDefinition Height="Auto"/> <!-- Close Button -->
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- App Icon and Main Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Rectangle Width="24" Height="24" Fill="#4CAF50" Margin="0,0,12,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M7,13H17V11H7"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="AH | RoomDataSync | Demo" 
                             FontSize="16" 
                             FontWeight="SemiBold" 
                             Foreground="#333"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             TextAlignment="Left"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" 
                      Name="CloseButton"
                      Width="24" Height="24"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      Click="CloseButton_Click">
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                        Fill="#999" 
                        Width="16" Height="16"/>
                </Button>
            </Grid>

            <!-- Main Progress Content -->
            <StackPanel Grid.Row="2">
                
                <!-- Current Detail -->
                <StackPanel>
                    <TextBlock Text="{Binding Detail}" 
                             FontSize="14" 
                             Foreground="#666" 
                             TextWrapping="Wrap"
                             Margin="0,0,0,16"/>
                </StackPanel>

                <!-- Step Progress -->
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Current Step" FontSize="12" Foreground="#999"/>
                        <TextBlock Grid.Column="1" 
                                 FontSize="12" 
                                 Foreground="#666">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding StepProgressPercentage, StringFormat={}{0:F0}%}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
                                            <Setter Property="Text" Value="Working..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <ProgressBar Value="{Binding StepProgress}" 
                               Maximum="1.0"
                               Style="{StaticResource ModernProgressBar}"
                               IsIndeterminate="{Binding IsIndeterminate}"/>
                </StackPanel>

                <!-- Overall Progress -->
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Overall Progress" FontSize="12" Foreground="#999"/>
                        <TextBlock Grid.Column="1" 
                                 Text="{Binding OverallProgressPercentage, StringFormat={}{0:F0}%}" 
                                 FontSize="12" 
                                 Foreground="#666"/>
                    </Grid>
                    
                    <ProgressBar Value="{Binding OverallProgress}" 
                               Maximum="1.0"
                               Style="{StaticResource ModernProgressBar}"/>
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="● " Foreground="#4CAF50" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="Mapping in progress..." FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>