<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>RoomsManagerAddin</RootNamespace>
    <AssemblyName>RoomsManagerAddin</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>10.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icons\room-16.png" />
    <EmbeddedResource Include="Resources\icons\room-32.png" />
    <EmbeddedResource Include="Resources\icons\setting-16.png" />
    <EmbeddedResource Include="Resources\icons\setting-32.png" />
    <EmbeddedResource Include="Resources\icons\help-16.png" />
    <EmbeddedResource Include="Resources\icons\help-32.png" />
  </ItemGroup>

  <!-- Exclude template files and drafts from build -->
  <ItemGroup>
    <Compile Remove="Resources\templates\**\*.cs" />
    <Page Remove="Resources\templates\**\*.xaml" />
    <None Remove="Resources\templates\**\*" />
    <EmbeddedResource Remove="Resources\templates\**\*" />
    <Page Remove="UI\drafts\**\*.xaml" />
    <Compile Remove="ProgressWindow.xaml.cs" />

    <!-- Exclude old folder structure (migrated to src/) -->
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="Controllers\**\*.cs" />
    <Compile Remove="Commands\**\*.cs" />
    <Compile Remove="Windows\**\*.cs" />
    <Page Remove="Windows\**\*.xaml" />

    <!-- Exclude old model files (split into individual classes in src/Domain/Models/) -->
    <Compile Remove="Models\FilterModels.cs" />
    <Compile Remove="Models\SharedModels.cs" />
    <Compile Remove="Models\ProgressInfo.cs" />
    <Compile Remove="Models\AppSettings.cs" />
    <!-- Keep ModelExports.cs for backward compatibility -->

    <!-- Exclude old UI files (migrated to src/Presentation/Controls/) -->
    <Compile Remove="UI\FilterRulesPanel.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="RoomsManagerAddin.addin" />
  </ItemGroup>
</Project>
