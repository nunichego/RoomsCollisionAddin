<!--
    EXAMPLE WINDOW - Demonstrates Modern Window Template Usage
    ===========================================================
    
    This example shows how to:
    1. Inherit from ModernWindowTemplate
    2. Configure window properties
    3. Override virtual methods
    4. Customize the item template
    5. Handle events and user interactions
    
    USAGE:
    - Copy this file to create new windows
    - Modify the class name and namespace
    - Customize the functionality as needed
    - Use as a reference for template usage
-->

<local:ModernWindowTemplate x:Class="AukettHeeseRevitAddin2024.Windows.Template.ExampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AukettHeeseRevitAddin2024.Windows.Template"
        Title="Example Window - Aukett + Heese"
        Height="800" Width="1000"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <!-- Override the default item template with custom content -->
    <local:ModernWindowTemplate.ItemTemplate>
        <DataTemplate>
            <Border Style="{StaticResource ModernCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Custom Preview Image -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource LightGray}" 
                            CornerRadius="8"
                            Margin="0,0,0,15"
                            BorderBrush="{StaticResource LightGrayDark}"
                            BorderThickness="1">
                        <Image x:Name="PreviewImage" 
                               Stretch="UniformToFill"
                               StretchDirection="Both"
                               Source="{Binding ImageSource}"
                               Margin="8"/>
                    </Border>

                    <!-- Custom Title -->
                    <TextBlock Grid.Row="1" 
                               Text="{Binding Title}" 
                               Style="{StaticResource TitleTextStyle}"/>

                    <!-- Custom Description -->
                    <TextBlock Grid.Row="2" 
                               Text="{Binding Description}" 
                               Style="{StaticResource BodyTextStyle}"
                               MaxHeight="60"/>

                    <!-- Custom Status Info -->
                    <StackPanel Grid.Row="3" Margin="0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Ellipse Style="{StaticResource StatusDotStyle}">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding StatusColor}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" 
                                       Style="{StaticResource StatusTextStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Category}" 
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextLight}"/>
                    </StackPanel>

                    <!-- Custom Action Buttons -->
                    <StackPanel Grid.Row="4" 
                                Orientation="Vertical" 
                                HorizontalAlignment="Stretch"
                                Margin="0,15,0,0">
                        <Button Content="📄 View Details" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ViewDetailsButton_Click"
                                Tag="{Binding}"/>
                        <Button Content="📂 Open Item" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OpenItemButton_Click"
                                Tag="{Binding}"/>
                        <Button Content="⭐ Favorite" 
                                Style="{StaticResource LightSecondaryButtonStyle}"
                                Click="FavoriteButton_Click"
                                Tag="{Binding}"
                                Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </local:ModernWindowTemplate.ItemTemplate>

</local:ModernWindowTemplate>
