<!--
    EXAMPLE SIMPLE WINDOW - Demonstrates Simple Window Template Usage
    ================================================================
    
    This example shows how to:
    1. Inherit from SimpleWindowTemplate
    2. Create tab-based settings interface
    3. Configure navigation and content
    4. Handle settings management
    5. Implement custom functionality
    
    USAGE:
    - Copy this file to create new simple windows
    - Modify the class name and namespace
    - Customize the functionality as needed
    - Use as a reference for template usage
-->

<local:SimpleWindowTemplate x:Class="AukettHeeseRevitAddin2024.Windows.Template.ExampleSimpleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AukettHeeseRevitAddin2024.Windows.Template"
        Title="Example Simple Window - Aukett + Heese"
        Height="600" Width="800"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <!-- Example Tab Content Panels -->
    
    <!-- General Settings Tab -->
    <Grid x:Name="GeneralSettingsPanel" Visibility="Collapsed">
        <StackPanel>
            <TextBlock Text="General Settings" Style="{StaticResource SectionHeaderStyle}"/>
            
            <GroupBox Header="Application Settings" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <CheckBox x:Name="ShowWelcomeMessageCheckBox" 
                              Content="Show welcome message on startup" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    
                    <CheckBox x:Name="AutoLoadContentCheckBox" 
                              Content="Automatically load content on startup" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    
                    <CheckBox x:Name="EnableNotificationsCheckBox" 
                              Content="Enable notifications" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Default window size:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="WindowSizeComboBox" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Width="120">
                            <ComboBoxItem Content="Small"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="Large"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Display Settings" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Theme:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="ThemeComboBox" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Width="120">
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="System"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Language:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="LanguageComboBox" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Width="120">
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="German"/>
                            <ComboBoxItem Content="French"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>

    <!-- Content Management Tab -->
    <Grid x:Name="ContentManagementPanel" Visibility="Collapsed">
        <StackPanel>
            <TextBlock Text="Content Management" Style="{StaticResource SectionHeaderStyle}"/>
            
            <GroupBox Header="Content Library Settings" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <TextBlock Text="Content metadata location:" 
                               FontSize="14" 
                               Foreground="#555555" 
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ContentMetadataLocationTextBox" 
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                        <Button Grid.Column="1" 
                                Content="Browse" 
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="8,0,0,0"
                                Padding="12,8"
                                Click="BrowseContentLocation_Click"/>
                    </Grid>
                    
                    <TextBlock x:Name="ContentMetadataStatusText" 
                               Text="Status: No content metadata location set" 
                               Style="{StaticResource StatusTextStyle}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Content Settings" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Maximum items per page:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="MaxItemsComboBox" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Width="100">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="25"/>
                            <ComboBoxItem Content="50"/>
                            <ComboBoxItem Content="100"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <CheckBox x:Name="ShowPreviewImagesCheckBox" 
                              Content="Show preview images" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    
                    <CheckBox x:Name="EnableSearchCheckBox" 
                              Content="Enable search functionality" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>

    <!-- Security Tab -->
    <Grid x:Name="SecurityPanel" Visibility="Collapsed">
        <StackPanel>
            <TextBlock Text="Security Settings" Style="{StaticResource SectionHeaderStyle}"/>
            
            <GroupBox Header="Authentication" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <CheckBox x:Name="RequirePasswordCheckBox" 
                              Content="Require password for admin functions" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    
                    <CheckBox x:Name="LogAdminActionsCheckBox" 
                              Content="Log all admin actions" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    
                    <CheckBox x:Name="EnableAuditTrailCheckBox" 
                              Content="Enable audit trail" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Password Settings" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Password expiration (days):" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        <TextBox x:Name="PasswordExpirationTextBox" 
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Width="100"/>
                    </StackPanel>
                    
                    <CheckBox x:Name="RequireComplexPasswordCheckBox" 
                              Content="Require complex passwords" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    
                    <CheckBox x:Name="EnablePasswordHistoryCheckBox" 
                              Content="Enable password history" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>

    <!-- Advanced Tab -->
    <Grid x:Name="AdvancedPanel" Visibility="Collapsed">
        <StackPanel>
            <TextBlock Text="Advanced Settings" Style="{StaticResource SectionHeaderStyle}"/>
            
            <GroupBox Header="Performance" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <CheckBox x:Name="EnableCachingCheckBox" 
                              Content="Enable content caching" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Cache size (MB):" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        <TextBox x:Name="CacheSizeTextBox" 
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Width="100"/>
                    </StackPanel>
                    
                    <CheckBox x:Name="EnableBackgroundUpdatesCheckBox" 
                              Content="Enable background updates" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Backup & Recovery" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <CheckBox x:Name="AutoBackupCheckBox" 
                              Content="Enable automatic backups" 
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="Backup frequency:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="BackupFrequencyComboBox" 
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Width="120">
                            <ComboBoxItem Content="Daily"/>
                            <ComboBoxItem Content="Weekly"/>
                            <ComboBoxItem Content="Monthly"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <TextBlock Text="Backup location:" 
                               FontSize="14" 
                               Foreground="#555555" 
                               Margin="0,8,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BackupLocationTextBox" 
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                        <Button Grid.Column="1" 
                                Content="Browse" 
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="8,0,0,0"
                                Padding="12,8"
                                Click="BrowseBackupLocation_Click"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>

    <!-- About Tab -->
    <Grid x:Name="AboutPanel" Visibility="Collapsed">
        <StackPanel>
            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}"/>
            
            <GroupBox Header="System Information" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <TextBlock Text="Aukett + Heese Revit Add-In 2024" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Version: 1.0.0" 
                               FontSize="14" 
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="Build Date: August 2024" 
                               FontSize="14" 
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="Target: Revit 2024" 
                               FontSize="14" 
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="Framework: .NET Framework 4.8" 
                               FontSize="14" 
                               Margin="0,0,0,16"/>
                    
                    <Button Content="Export Configuration" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="150"
                            HorizontalAlignment="Left"
                            Click="ExportConfiguration_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Support" Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <TextBlock Text="For support and questions:" 
                               FontSize="14" 
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Email: support@aukett-heese.de" 
                               FontSize="14" 
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="Phone: +49 30 12345678" 
                               FontSize="14" 
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="Website: www.aukett-heese.de" 
                               FontSize="14" 
                               Margin="0,0,0,16"/>
                    
                    <Button Content="Check for Updates" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="150"
                            HorizontalAlignment="Left"
                            Click="CheckForUpdates_Click"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>

</local:AdminPanelTemplate>
